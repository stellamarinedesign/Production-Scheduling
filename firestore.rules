rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────
// Firestore security rules — reference copy, versioned alongside the code.
// This file does NOT auto-deploy: after editing it, paste the contents into
// the Firebase console (Firestore Database → Rules → Publish), or deploy with
// the Firebase CLI (`firebase deploy --only firestore:rules`).
//
// SECURITY MODEL: as per the Material Ordering app. There is no per-user
// login — access is gated by Firebase App Check (reCAPTCHA v3, enforced; see
// APPCHECK_SITE_KEY in js/store.js) plus the Firebase config being
// distributed only to authorised workshop devices. App Check is the real gate
// here, not the rules. Every collection the app uses is listed explicitly;
// the catch-all at the bottom denies everything else.
//
// NOTE: until App Check is registered and enforced, these rules leave the
// data open to anyone who reads the config out of the page source. Do not
// publish the site with a real Firebase project until App Check is on.
// ─────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // Vessel code cross-reference. `display` is a hand-maintained human
    // decision — see STELLA_PRODUCTION_BOARD_CONTEXT.md §2.5.
    match /vesselCodes/{stellaCode} {
      allow read, write: if true;
    }

    // Per-job manager decisions, keyed on production number. Production
    // numbers are stable and never reused, so they are a safe key and the
    // decision survives the next export upload.
    match /jobOverrides/{prodNo} {
      allow read, write: if true;
    }

    // Import history — audit trail and Gantt actuals later.
    match /imports/{importId} {
      allow read, write: if true;
    }

    // Horizon, stock cap, auto-fit.
    match /settings/{docId} {
      allow read, write: if true;
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
